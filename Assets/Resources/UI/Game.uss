/* Dark palette of the suma-manual GUI. */
.game-root {
    --bg: #1e1e2e;
    --bg2: #2a2a3e;
    --border: #3a3a5e;
    --accent: #7c3aed;
    --text: #e2e8f0;
    --muted: #94a3b8;
    color: var(--text);
    font-size: 14px;
}

.panel {
    background-color: rgba(30, 30, 46, 0.94);
    border-color: var(--border);
    border-width: 1px;
    border-radius: 8px;
    padding: 10px 12px;
}

.title {
    -unity-font-style: bold;
    font-size: 16px;
    color: var(--text);
}

.muted {
    color: var(--muted);
    font-size: 12px;
}

.row {
    flex-direction: row;
    align-items: center;
}

.button {
    background-color: var(--bg2);
    border-color: var(--border);
    border-width: 1px;
    border-radius: 4px;
    color: var(--text);
    padding: 3px 10px;
    margin: 0 6px 0 0;
}

.button:hover {
    border-color: var(--accent);
}

.button--on {
    background-color: var(--accent);
}

.brain-panel {
    position: absolute;
    top: 10px;
    right: 10px;
    bottom: 10px;
    width: 470px;
}

.brain-hint {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 4px 10px;
}

.network {
    flex-grow: 1;
    margin: 8px 0;
    min-height: 300px;
}

.neuron-label {
    position: absolute;
    height: 16px;
    font-size: 11px;
    color: var(--text);
    padding: 0;
    margin: 0;
}

.chart {
    height: 170px;
    background-color: var(--bg2);
    border-radius: 4px;
    margin-top: 4px;
}

.chart-axis {
    position: absolute;
    font-size: 10px;
    color: var(--muted);
}

.legend-best {
    color: #a78bfa;
}

.legend-average {
    color: #22c55e;
}
