/* Dark palette of the suma-manual GUI. */
.game-root {
    --bg: #1e1e2e;
    --bg2: #2a2a3e;
    --border: #3a3a5e;
    --accent: #7c3aed;
    --text: #e2e8f0;
    --muted: #94a3b8;
    color: var(--text);
    font-size: 14px;
}

.panel {
    background-color: rgba(30, 30, 46, 0.94);
    border-color: var(--border);
    border-width: 1px;
    border-radius: 8px;
    padding: 10px 12px;
}

.title {
    -unity-font-style: bold;
    font-size: 16px;
    color: var(--text);
}

.muted {
    color: var(--muted);
    font-size: 13px;
}

.row {
    flex-direction: row;
    align-items: center;
}

.button {
    background-color: var(--bg2);
    border-color: var(--border);
    border-width: 1px;
    border-radius: 4px;
    color: var(--text);
    padding: 3px 10px;
    margin: 0 6px 0 0;
}

.button:hover {
    border-color: var(--accent);
}

.button--on {
    background-color: var(--accent);
}

.brain-panel {
    position: absolute;
    top: 10px;
    right: 10px;
    bottom: 10px;
    width: 470px;
}

.brain-hint {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 4px 10px;
}

.network {
    flex-grow: 1;
    margin: 8px 0;
    min-height: 300px;
}

.neuron-label {
    position: absolute;
    height: 16px;
    font-size: 12px;
    color: var(--text);
    padding: 0;
    margin: 0;
}

.chart {
    height: 170px;
    background-color: var(--bg2);
    border-radius: 4px;
    margin-top: 4px;
}

.chart-axis {
    position: absolute;
    font-size: 10px;
    color: var(--muted);
}

.legend-best {
    color: #a78bfa;
}

.legend-average {
    color: #22c55e;
}

.button--big {
    font-size: 16px;
    padding: 8px 22px;
    margin: 6px 0 0 8px;
}

.hud {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 340px;
}

.hud Label {
    margin: 1px 0;
}

/* Fields on the dark panels. */
.game-root .unity-base-field__label {
    color: var(--text);
    min-width: 210px;
}

.game-root .unity-base-field__input,
.game-root .unity-base-popup-field__input {
    background-color: var(--bg2);
    border-color: var(--border);
    color: var(--text);
}

.game-root .unity-base-field {
    margin: 6px 0;
}

.menu-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--bg);
    align-items: center;
    justify-content: center;
}

.menu {
    width: 980px;
    max-width: 96%;
    max-height: 94%;
    padding: 24px 28px;
}

.menu-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--text);
    margin-bottom: 4px;
}

.menu-columns {
    flex-direction: row;
    margin-top: 18px;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.menu-modes {
    width: 40%;
    margin-right: 22px;
}

.menu-options {
    flex-grow: 1;
    min-height: 300px;
}

.mode-button {
    background-color: var(--bg2);
    border-color: var(--border);
    border-width: 1px;
    border-radius: 6px;
    padding: 10px 12px;
    margin: 0 0 8px 0;
    align-items: flex-start;
}

.mode-button:hover {
    border-color: var(--accent);
}

.mode-button--selected {
    border-color: var(--accent);
    border-width: 2px;
    background-color: rgba(124, 58, 237, 0.25);
}

.mode-button .muted {
    -unity-text-align: upper-left;
}

.mode-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--text);
}

.menu-note {
    white-space: normal;
    margin-top: 10px;
}

.pause-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.pause-box {
    width: 320px;
    padding: 20px 24px;
    align-items: stretch;
}

.pause-box .button--big {
    margin: 8px 0 0 0;
}

/* Dark scrollbar instead of the default light one. */
.game-root .unity-scroller--vertical {
    width: 8px;
}

.game-root .unity-scroller .unity-base-slider__tracker {
    background-color: var(--bg2);
    border-width: 0;
}

.game-root .unity-scroller .unity-base-slider__dragger {
    background-color: var(--border);
    border-width: 0;
    border-radius: 4px;
}

.game-root .unity-scroller .unity-repeat-button {
    display: none;
}
